# Copy to frontend/.env.local if needed. Only VITE_* variables reach the browser,
# so NEVER put secrets (e.g. ANTHROPIC_API_KEY) here - the key lives on the backend only.

# Where the Vite dev server proxies /api, /accounts and /admin (dev only).
VITE_BACKEND_URL=http://localhost:8000
# Optional absolute API base. Leave empty to use same-origin requests (recommended:
# keeps the session + CSRF cookies first-party).
VITE_API_URL=
