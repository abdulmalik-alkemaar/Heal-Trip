# Copy to `.env` (repo root) and fill in. `.env` is gitignored - never commit real secrets.
# python-decouple searches upward from backend/, so this root .env is picked up by Django.

# --- Django --------------------------------------------------------------
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (PostgreSQL in every environment; no SQLite) ---------------
# Local dev (portable Postgres or `docker compose up postgres`):
DATABASE_URL=postgresql://healtrip:healtrip@localhost:5432/healtrip
# Used by docker-compose's postgres service:
POSTGRES_USER=healtrip
POSTGRES_PASSWORD=healtrip
POSTGRES_DB=healtrip
# Optional least privilege: a SELECT-only role for agent tool queries
# (create it with docs/sql/readonly_role.sql). Leave empty to use DATABASE_URL.
DATABASE_URL_READONLY=

# --- LLM / Agent ----------------------------------------------------------
# Server-side only. Never exposed to the frontend, never logged.
ANTHROPIC_API_KEY=
# anthropic | mock   (mock = deterministic scripted responses, no key needed)
LLM_PROVIDER=mock
LLM_MODEL=claude-sonnet-5-5
# low | medium | high
LLM_EFFORT=medium
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
# Server-side refusal fallback on the Claude API (re-runs a declined request on a fallback model)
LLM_REFUSAL_FALLBACK=True
AGENT_MAX_ITERATIONS=5
AGENT_MAX_CLARIFICATION_ROUNDS=3

# --- Abuse / budget protection -------------------------------------------
CHAT_RATE_PER_MINUTE=20
CHAT_RATE_PER_DAY=200
CHAT_SESSION_RATE=10/min
SESSION_CREATE_RATE=30/hour
CHAT_MAX_MESSAGES_PER_SESSION=50
# Global cap on assistant turns per rolling 24h across ALL users (protects the demo LLM budget). 0 = unlimited.
DEMO_DAILY_MESSAGE_CAP=0
# Retention policy used by `manage.py purge_old_sessions`
CHAT_RETENTION_DAYS=30

# Number of reverse proxies in front of Django (client IP from X-Forwarded-For). Prod default: 2
NUM_PROXIES=

# --- Logging --------------------------------------------------------------
# json | console
LOG_FORMAT=console
LOG_LEVEL=INFO

# --- Google OAuth (optional - chat works anonymously) --------------------
# Get credentials from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CORS and CSRF (development) -----------------------------------------
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Optional -------------------------------------------------------------
SITE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/1

# Superuser (for automated creation by `manage.py setup_superuser`)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=

# Frontend
FRONTEND_URL=http://localhost:3000
