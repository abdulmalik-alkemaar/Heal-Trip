
# Railway Backend Service Environment Variables
# Set these in your Railway dashboard for the backend service (Variables -> Raw Editor).
#
# Variables using ${{ }} syntax reference other Railway services/variables.
# They are resolved automatically by Railway at deploy time.
#
# IMPORTANT: Replace all "secret-change-me" values with real secrets before deploying.

RAILWAY_DOCKERFILE_PATH="backend/Dockerfile"
DJANGO_SETTINGS_MODULE="healtrip.production_settings"
DEBUG="False"
SECRET_KEY="secret-change-me"

# nginx (frontend service) forwards the browser's Host header, so the FRONTEND's public
# domain must be allowed here, plus the private domain and Railway's health-check host.
ALLOWED_HOSTS="${{frontend.RAILWAY_PUBLIC_DOMAIN}},.railway.internal,healthcheck.railway.app,localhost,127.0.0.1"
CORS_ALLOWED_ORIGINS="https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}"
CSRF_TRUSTED_ORIGINS="https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}"
FRONTEND_URL="https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}"
SITE_URL="https://${{frontend.RAILWAY_PUBLIC_DOMAIN}}"

DATABASE_URL="${{Postgres.DATABASE_URL}}"
# Optional least privilege (see docs/SECURITY.md): SELECT-only role for agent tools.
# DATABASE_URL_READONLY="postgresql://healtrip_tools:<password>@${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}"
# Optional but recommended: shared throttle counters across gunicorn workers.
# REDIS_URL="${{Redis.REDIS_URL}}"

# --- LLM (server-side only) ---
ANTHROPIC_API_KEY="secret-change-me"
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-sonnet-5-5"
LLM_EFFORT="medium"
LLM_TIMEOUT_SECONDS="30"
LLM_MAX_RETRIES="2"
LLM_REFUSAL_FALLBACK="True"
AGENT_MAX_ITERATIONS="5"

# --- Demo safety (public link): strict limits protect the LLM budget ---
CHAT_RATE_PER_MINUTE="10"
CHAT_RATE_PER_DAY="60"
CHAT_MAX_MESSAGES_PER_SESSION="50"
DEMO_DAILY_MESSAGE_CAP="500"
NUM_PROXIES="2"
LOG_FORMAT="json"

# --- Optional: Google OAuth + admin user ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DJANGO_SUPERUSER_EMAIL="admin@example.com"
DJANGO_SUPERUSER_PASSWORD="secret-change-me"
DJANGO_SUPERUSER_USERNAME="admin"
